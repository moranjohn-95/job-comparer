# Local development only. Choose a new password and use it in both settings.
POSTGRES_USER=job_comparer_dev
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=job_comparer_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://job_comparer_dev:replace-with-a-local-password@127.0.0.1:5432/job_comparer_dev
# Explicit local HTTP setup. Production: APP_ENV=production,
# SESSION_COOKIE_SECURE=true, AUTH_ALLOWED_ORIGINS=https://your-app-host.
# Origins are comma-separated exact origins, without paths or trailing slashes.
APP_ENV=development
SESSION_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Serve the production frontend and /api on the same HTTPS origin. The reverse
# proxy forwards /api/* to the API with /api stripped. Vite does this locally
# using port 8001. Restart the API after changing authentication settings.
# Absolute database-session lifetime in positive whole seconds (default 3600).
# Applies when issuing a session; database expiry remains authoritative.
SESSION_LIFETIME_SECONDS=3600
# Public browser URL, optionally including the deployed frontend base path.
# Required for mail links; its origin must be in AUTH_ALLOWED_ORIGINS.
# Production requires HTTPS. Never derive this from a request Host header.
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
# Absolute verification expiry (1..31536000 seconds), default 24 hours.
EMAIL_VERIFICATION_LIFETIME_SECONDS=86400
# Real SMTP is required, including in development. Supply your provider's
# credentials privately. Missing/invalid settings result in a resendable error.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# implicit: verified TLS from connect (usually 465).
# starttls: mandatory verified STARTTLS before login (usually 587).
SMTP_TLS_MODE=implicit
# Per-connection/socket-operation timeout, 1..30 seconds; no automatic retries.
SMTP_TIMEOUT_SECONDS=10
# Comma-separated reverse-proxy IP addresses. Leave empty when the app is
# directly internet-facing; only listed peers may supply X-Forwarded-For.
TRUSTED_PROXY_IPS=

# AI comparisons stay off unless this is explicitly set to true.
AI_COMPARISON_ENABLED=false
# Optional app-wide limits; defaults are 10/day and 50/month.
# Optional per-account daily limit; default is 3.
# AI_ACCOUNT_DAILY_LIMIT=3
# AI_APP_DAILY_LIMIT=10
# AI_APP_MONTHLY_LIMIT=50
# Required only when AI_COMPARISON_ENABLED=true. Keep the key private.
OPENAI_API_KEY=replace-with-your-api-key
# The server currently allows only gpt-6.1-sol.
OPENAI_MODEL=gpt-6.1-sol

# Separate PostgreSQL container and volume for tests.
POSTGRES_TEST_USER=job_comparer_test
POSTGRES_TEST_PASSWORD=replace-with-a-different-local-password
POSTGRES_TEST_DB=job_comparer_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://job_comparer_test:replace-with-a-different-local-password@127.0.0.1:5433/job_comparer_test
