# Local development only. Choose a new password and use it in both settings.
POSTGRES_USER=job_comparer_dev
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=job_comparer_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://job_comparer_dev:replace-with-a-local-password@127.0.0.1:5432/job_comparer_dev
AUTH_SECRET_KEY=replace-with-a-long-random-secret
# Absolute database-session lifetime in positive whole seconds (default 3600).
# Applies at issuance; existing JWT login is unchanged in this foundation step.
SESSION_LIFETIME_SECONDS=3600
# Comma-separated reverse-proxy IP addresses. Leave empty when the app is
# directly internet-facing; only listed peers may supply X-Forwarded-For.
TRUSTED_PROXY_IPS=

# AI comparisons stay off unless this is explicitly set to true.
AI_COMPARISON_ENABLED=false
# Optional app-wide limits; defaults are 10/day and 50/month.
# Optional per-account daily limit; default is 3.
# AI_ACCOUNT_DAILY_LIMIT=3
# AI_APP_DAILY_LIMIT=10
# AI_APP_MONTHLY_LIMIT=50
# Required only when AI_COMPARISON_ENABLED=true. Keep the key private.
OPENAI_API_KEY=replace-with-your-api-key
# The server currently allows only gpt-6.1-sol.
OPENAI_MODEL=gpt-6.1-sol

# Separate PostgreSQL container and volume for tests.
POSTGRES_TEST_USER=job_comparer_test
POSTGRES_TEST_PASSWORD=replace-with-a-different-local-password
POSTGRES_TEST_DB=job_comparer_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://job_comparer_test:replace-with-a-different-local-password@127.0.0.1:5433/job_comparer_test
